{
  "additional_frontmatter_fields": [],
  "limits": {
    "max_file_bytes": 65536,
    "max_file_count": 20,
    "max_skill_body_characters": 12000,
    "max_total_bytes": 196608
  },
  "permitted_agent_files": ["openai.yaml"],
  "schema_version": 1,
  "secret_scan": {
    "credential_assignments": "error",
    "private_key_headers": "error"
  },
  "suffix_allowlists": {
    "assets": [".gif", ".jpeg", ".jpg", ".png", ".svg", ".webp"],
    "references": [".json", ".md"],
    "scripts": [".py"]
  }
}
